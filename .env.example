# Copy to .env and fill in ONE of the two options. .env is git-ignored. Never commit real credentials.
# Kaggle → Settings → API.

# Option A (new tokens): "Generate New Token" gives a single token value.
KAGGLE_API_TOKEN=

# Option B (legacy): "Create Legacy API Key" downloads kaggle.json containing username + key.
KAGGLE_USERNAME=
KAGGLE_KEY=

# Google Cloud (only needed to deploy; see README "Deploy to Google Cloud Run")
GCP_PROJECT=
GCP_REGION=us-central1
